# ─── Database ───────────────────────────────────────────────────────────
# Neon (recommended) → https://neon.tech — free Postgres with branching.
# Local pg works too: postgres://postgres:postgres@localhost:5432/jobhunt
DATABASE_URL=

# ─── Security ───────────────────────────────────────────────────────────
# Shared secret protecting scan endpoints + cron calls. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SCAN_SECRET=

# Optional: simple gate on the dashboard itself (single-user mode).
DASHBOARD_TOKEN=

# ─── CORS ───────────────────────────────────────────────────────────────
# Origin allowed to call the API. Set to your Vercel URL in production.
CLIENT_ORIGIN=http://localhost:5173

# ─── Job source API keys ────────────────────────────────────────────────
# All optional — scrapers skip cleanly when their key is missing.

# Adzuna → https://developer.adzuna.com/ (free tier, 5000/day)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# JSearch via RapidAPI → https://rapidapi.com/letscrape-f6mXWxLQV4u/api/jsearch4
# Surfaces LinkedIn-sourced roles without scraping LinkedIn directly.
JSEARCH_RAPIDAPI_KEY=

# ─── Client build vars ──────────────────────────────────────────────────
# Exposed to the browser via import.meta.env — must be safe to ship.
# Optional: lets the "Refresh now" button authenticate to /api/scan.
# IMPORTANT: Vite normally only reads .env from client/, but this repo sets
# `envDir` to the monorepo root in client/vite.config.ts, so root .env works.
# On Vercel, set VITE_SCAN_SECRET as a Project Environment Variable for both
# Production and Preview — it is baked in at build time, so a rebuild is
# required after changing it.
VITE_SCAN_SECRET=

# ─── Vercel-only ────────────────────────────────────────────────────────
# Vercel automatically sets PORT and VERCEL=1.
