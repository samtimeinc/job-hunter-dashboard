{
  "name": "jobhunt-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint \"**/*.{ts,tsx}\" --ignore-pattern node_modules --ignore-pattern dist",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "scan": "tsx server/scripts/run-scan.ts",
    "prune:locations": "tsx server/scripts/prune-locations.ts",
    "db:generate": "npm run generate -w server",
    "db:push": "npm run push -w server",
    "db:studio": "npm run studio -w server"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.23.0",
    "drizzle-orm": "^0.32.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.1"
  }
}
